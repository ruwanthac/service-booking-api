// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("booking_status")
}

// ---------- Models ----------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  // Store only a hash (bcrypt/argon2). Never persist plaintext.
  password  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  // Duration in minutes.
  duration    Int
  // Monetary value — always Decimal, never Float.
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings Booking[]

  // Common filter: WHERE is_active = true
  @@index([isActive])
  @@map("services")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  customerName  String        @map("customer_name")
  customerEmail String        @map("customer_email")
  customerPhone String        @map("customer_phone")
  bookingDate   DateTime      @map("booking_date") @db.Date
  bookingTime   DateTime      @map("booking_time") @db.Time(0)
  status        BookingStatus @default(PENDING)
  notes         String?

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Hard guarantee: no two bookings for the same service in the same slot.
  @@unique([serviceId, bookingDate, bookingTime], name: "booking_service_slot_unique")
  // Dashboard filters (e.g. all PENDING bookings).
  @@index([status])
  // Global "bookings on date X" queries across services.
  @@index([bookingDate])
  // Look up all bookings for a given customer email.
  @@index([customerEmail])
  @@map("bookings")
}
